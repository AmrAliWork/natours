extends base

block content
  main.main
    .login-form
      h2.heading-secondary.ma-bt-lg Reset your password

      form.form.form--reset-password
        .form__group
          label.form__label(for='password') New password
          input#password.form__input(
            type='password'
            placeholder='••••••••'
            required
            minlength='8'
            maxlength='16'
          )

        .form__group
          label.form__label(for='passwordConfirm') Confirm password
          input#passwordConfirm.form__input(
            type='password'
            placeholder='••••••••'
            required
            minlength='8'
            maxlength='16'
          )

        .form__group
          button.btn.btn--green(type='submit') Reset password